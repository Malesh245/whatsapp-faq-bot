# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible API ---
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
# Leave empty for OpenAI. Other providers:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   (LLM_MODEL=gemini-2.5-flash)
#   Groq:          https://api.groq.com/openai/v1                              (LLM_MODEL=llama-3.3-70b-versatile)
#   Ollama:        http://localhost:11434/v1                                   (LLM_API_KEY=ollama)
LLM_BASE_URL=

# --- Storage / behaviour ---
DATABASE_PATH=data/bot.db
FAQ_PATH=data/faq.md
HISTORY_LIMIT=10

# --- WhatsApp Cloud API (optional; not needed for simulated requests) ---
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0

# --- Protects /handoffs, /leads, /conversations (send as X-API-Key header). Empty = open. ---
ADMIN_API_KEY=
